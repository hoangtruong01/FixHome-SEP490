# FixHome AI Service Environment Configuration
# Copy this file to .env and fill in the values

# AI Provider: "gemini", "openai", or "mock"
AI_PROVIDER=gemini

# Gemini API Key (leave blank or provide your test key)
GEMINI_API_KEY=

# OpenAI API Key (leave blank or provide your test key)
OPENAI_API_KEY=

# Confidence threshold for advisory flag (0.0 to 1.0)
AI_CONFIDENCE_THRESHOLD=0.6

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000"]
