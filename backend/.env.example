# FixHome Backend Environment Configuration
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fixhome
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# JWT Authentication
JWT_SECRET=fixhome-jwt-secret-change-in-production
JWT_EXPIRATION=1d

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Cloudinary (optional – configure when implementing media upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (optional – configure when implementing location features)
GOOGLE_MAPS_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:19006
